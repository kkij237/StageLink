<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:comp="clr-namespace:StageLink.Views.Components"
             x:Class="StageLink.Views.ProfilePage"
             Shell.NavBarIsVisible="False">
	<Grid RowDefinitions="Auto,*">

		<comp:AppHeader Grid.Row="0" Subtitle="Profil" />

		<ScrollView Grid.Row="1">
			<VerticalStackLayout Padding="16,8,16,24" Spacing="24">

				<!-- Identité -->
				<VerticalStackLayout Spacing="6" HorizontalOptions="Center">
					<Border WidthRequest="80" HeightRequest="80" StrokeShape="RoundRectangle 40" StrokeThickness="2"
					        Stroke="{StaticResource SurfaceVariant}" BackgroundColor="{StaticResource SurfaceContainer}"
					        HorizontalOptions="Center">
						<Label Text="{Binding Profile.Initials}" FontSize="26" FontAttributes="Bold"
						       TextColor="{StaticResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
					</Border>
					<Label Text="{Binding Profile.FullName}" Style="{StaticResource LabelHeadline}" FontSize="20"
					       HorizontalOptions="Center" Margin="0,6,0,0" />
					<Label Text="{Binding Profile.Subtitle}" Style="{StaticResource LabelBody}"
					       HorizontalTextAlignment="Center" />
					<Border StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="12,5"
					        BackgroundColor="{StaticResource SurfaceContainer}" HorizontalOptions="Center" Margin="0,6,0,0">
						<HorizontalStackLayout Spacing="6">
							<Label Text="●" FontSize="10" TextColor="{StaticResource Primary}" VerticalOptions="Center" />
							<Label Text="{Binding Profile.Status}" FontSize="10" FontAttributes="Bold"
							       TextColor="{StaticResource OnSurfaceVariant}" VerticalOptions="Center" />
						</HorizontalStackLayout>
					</Border>
				</VerticalStackLayout>

				<!-- Compétences -->
				<VerticalStackLayout Spacing="10">
					<Grid ColumnDefinitions="*,Auto">
						<Label Text="Compétences" Style="{StaticResource LabelTitle}" />
						<Label Grid.Column="1" Text="{Binding Profile.SkillsCountLabel}" Style="{StaticResource LabelCaption}"
						       FontSize="10" VerticalOptions="Center" />
					</Grid>
					<BoxView HeightRequest="1" Color="{StaticResource SurfaceVariant}" Opacity="0.5" />
					<FlexLayout BindableLayout.ItemsSource="{Binding Profile.Skills}" Wrap="Wrap">
						<BindableLayout.ItemTemplate>
							<DataTemplate>
								<Border Style="{StaticResource Chip}" Margin="0,0,8,8">
									<Label Text="{Binding .}" FontSize="12" />
								</Border>
							</DataTemplate>
						</BindableLayout.ItemTemplate>
					</FlexLayout>
				</VerticalStackLayout>

				<!-- Documents -->
				<VerticalStackLayout Spacing="10">
					<Label Text="Documents" Style="{StaticResource LabelTitle}" />
					<BoxView HeightRequest="1" Color="{StaticResource SurfaceVariant}" Opacity="0.5" />
					<Border Style="{StaticResource Card}" Padding="12">
						<Border.GestureRecognizers>
							<TapGestureRecognizer Command="{Binding DownloadCvCommand}" />
						</Border.GestureRecognizers>
						<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
							<Label Text="📄" FontSize="20" VerticalOptions="Center" />
							<VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
								<Label Text="{Binding Profile.CvLabel}" FontAttributes="Bold" />
								<Label Text="Mis à jour récemment" Style="{StaticResource LabelBody}" FontSize="12" />
							</VerticalStackLayout>
							<Label Grid.Column="2" Text="⬇" FontSize="18" TextColor="{StaticResource OnSurfaceVariant}"
							       VerticalOptions="Center" />
						</Grid>
					</Border>
				</VerticalStackLayout>

				<!-- Préférences -->
				<VerticalStackLayout Spacing="10">
					<Label Text="Préférences" Style="{StaticResource LabelTitle}" />
					<BoxView HeightRequest="1" Color="{StaticResource SurfaceVariant}" Opacity="0.5" />
					<Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
						<Label Grid.Row="0" Text="Domaine" Style="{StaticResource LabelBody}" FontSize="12" />
						<Label Grid.Row="0" Grid.Column="1" Text="{Binding Profile.Domain}" FontSize="12"
						       FontAttributes="Bold" HorizontalTextAlignment="End" />
						<Label Grid.Row="1" Text="Lieu" Style="{StaticResource LabelBody}" FontSize="12" />
						<Label Grid.Row="1" Grid.Column="1" Text="{Binding Profile.Location}" FontSize="12"
						       FontAttributes="Bold" HorizontalTextAlignment="End" />
						<Label Grid.Row="2" Text="Disponibilité" Style="{StaticResource LabelBody}" FontSize="12" />
						<Label Grid.Row="2" Grid.Column="1" Text="{Binding Profile.Availability}" FontSize="12"
						       FontAttributes="Bold" HorizontalTextAlignment="End" />
					</Grid>
				</VerticalStackLayout>

				<!-- Raccourcis -->
				<Border Style="{StaticResource Card}" Padding="12">
					<Border.GestureRecognizers>
						<TapGestureRecognizer Command="{Binding OpenAlertsCommand}" />
					</Border.GestureRecognizers>
					<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
						<Label Text="🔔" FontSize="20" VerticalOptions="Center" />
						<Label Grid.Column="1" Text="Alertes &amp; notifications" FontAttributes="Bold" VerticalOptions="Center" />
						<Label Grid.Column="2" Text="›" FontSize="20" TextColor="{StaticResource OnSurfaceVariant}"
						       VerticalOptions="Center" />
					</Grid>
				</Border>

				<Button Text="Se déconnecter" Command="{Binding LogoutCommand}" Style="{StaticResource SecondaryButton}"
				        TextColor="{StaticResource Error}" />
			</VerticalStackLayout>
		</ScrollView>
	</Grid>
</ContentPage>

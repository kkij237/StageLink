<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:comp="clr-namespace:StageLink.Views.Components"
             xmlns:conv="clr-namespace:StageLink.Converters"
             x:Class="StageLink.Views.ApplicationsPage"
             x:Name="Page"
             Shell.NavBarIsVisible="False">
	<ContentPage.Resources>
		<conv:StatusColorConverter x:Key="StatusColor" />
	</ContentPage.Resources>

	<Grid RowDefinitions="Auto,Auto,Auto,*">

		<comp:AppHeader Grid.Row="0" Subtitle="Candidatures" />

		<Grid Grid.Row="1" ColumnDefinitions="*,Auto" Padding="16,4,16,8">
			<Label Text="Mes Candidatures" Style="{StaticResource LabelHeadline}" />
			<Label Grid.Column="1" Text="{Binding CountLabel}" FontSize="12" FontAttributes="Bold"
			       TextColor="{StaticResource OnSurfaceVariant}" VerticalOptions="Center" />
		</Grid>

		<CollectionView Grid.Row="2" ItemsSource="{Binding Filters}" ItemsLayout="HorizontalList"
		                HeightRequest="48" SelectionMode="None" Margin="16,0,0,8">
			<CollectionView.ItemTemplate>
				<DataTemplate>
					<comp:FilterChipView Margin="0,0,8,0"
					                     Command="{Binding BindingContext.SelectFilterCommand, Source={x:Reference Page}}" />
				</DataTemplate>
			</CollectionView.ItemTemplate>
		</CollectionView>

		<CollectionView Grid.Row="3" ItemsSource="{Binding Applications}" SelectionMode="None" Margin="16,0">
			<CollectionView.ItemsLayout>
				<LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
			</CollectionView.ItemsLayout>
			<CollectionView.ItemTemplate>
				<DataTemplate>
					<Border Style="{StaticResource Card}" Padding="12">
						<VerticalStackLayout Spacing="8">
							<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
								<Border WidthRequest="40" HeightRequest="40" StrokeThickness="0"
								        StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource SurfaceVariant}">
									<Label Text="{Binding Initials}" FontAttributes="Bold" HorizontalOptions="Center"
									       VerticalOptions="Center" TextColor="{StaticResource Primary}" />
								</Border>
								<VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
									<Label Text="{Binding Company}" Style="{StaticResource LabelTitle}"
									       LineBreakMode="TailTruncation" MaxLines="1" />
									<Label Text="{Binding Position}" Style="{StaticResource LabelBody}" FontSize="12"
									       LineBreakMode="TailTruncation" MaxLines="1" />
								</VerticalStackLayout>
								<Border Grid.Column="2" StrokeThickness="0" StrokeShape="RoundRectangle 12"
								        Padding="10,4" VerticalOptions="Start"
								        BackgroundColor="{Binding Status, Converter={StaticResource StatusColor}, ConverterParameter=bg}">
									<Label Text="{Binding StatusLabel}" FontSize="10" FontAttributes="Bold"
									       TextColor="{Binding Status, Converter={StaticResource StatusColor}, ConverterParameter=fg}" />
								</Border>
							</Grid>

							<BoxView HeightRequest="1" Color="{StaticResource OutlineVariant}" Opacity="0.4" />

							<Grid ColumnDefinitions="*,Auto">
								<Label Text="{Binding DateLabel}" Style="{StaticResource LabelBody}" FontSize="12"
								       VerticalOptions="Center" />
								<Button Grid.Column="1" Text="{Binding ActionLabel}"
								        Style="{StaticResource SmallPrimaryButton}" IsVisible="{Binding IsPrimaryAction}"
								        Command="{Binding BindingContext.OpenActionCommand, Source={x:Reference Page}}"
								        CommandParameter="{Binding .}" />
								<Button Grid.Column="1" Text="{Binding ActionLabel}"
								        Style="{StaticResource SmallSecondaryButton}" IsVisible="{Binding IsSecondaryAction}"
								        Command="{Binding BindingContext.OpenActionCommand, Source={x:Reference Page}}"
								        CommandParameter="{Binding .}" />
							</Grid>
						</VerticalStackLayout>
					</Border>
				</DataTemplate>
			</CollectionView.ItemTemplate>
			<CollectionView.EmptyView>
				<Label Text="Aucune candidature dans cette catégorie." Style="{StaticResource LabelBody}"
				       HorizontalTextAlignment="Center" Margin="0,48,0,0" />
			</CollectionView.EmptyView>
			<CollectionView.Footer>
				<BoxView HeightRequest="16" Color="Transparent" />
			</CollectionView.Footer>
		</CollectionView>
	</Grid>
</ContentPage>

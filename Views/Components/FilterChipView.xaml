<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="StageLink.Views.Components.FilterChipView"
             x:Name="Root">
	<Border StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="14,8"
	        BackgroundColor="{StaticResource SurfaceContainer}" VerticalOptions="Center">
		<Border.GestureRecognizers>
			<TapGestureRecognizer Command="{Binding Command, Source={x:Reference Root}}"
			                      CommandParameter="{Binding .}" />
		</Border.GestureRecognizers>
		<Border.Triggers>
			<DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
				<Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
			</DataTrigger>
		</Border.Triggers>
		<HorizontalStackLayout Spacing="6">
			<Label Text="{Binding Label}" FontSize="13" FontAttributes="Bold"
			       TextColor="{StaticResource OnSurfaceVariant}" VerticalOptions="Center">
				<Label.Triggers>
					<DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
						<Setter Property="TextColor" Value="{StaticResource OnPrimary}" />
					</DataTrigger>
				</Label.Triggers>
			</Label>
			<Label Text="{Binding Count}" IsVisible="{Binding HasCount}" FontSize="11"
			       TextColor="{StaticResource Outline}" VerticalOptions="Center">
				<Label.Triggers>
					<DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
						<Setter Property="TextColor" Value="{StaticResource OnPrimary}" />
					</DataTrigger>
				</Label.Triggers>
			</Label>
		</HorizontalStackLayout>
	</Border>
</ContentView>

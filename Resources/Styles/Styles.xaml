<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

	<!-- ===== Implicites ===== -->
	<Style TargetType="ContentPage" ApplyToDerivedTypes="True">
		<Setter Property="BackgroundColor" Value="{StaticResource Surface}" />
	</Style>

	<Style TargetType="Label">
		<Setter Property="TextColor" Value="{StaticResource OnSurface}" />
		<Setter Property="FontSize" Value="14" />
	</Style>

	<Style TargetType="Entry">
		<Setter Property="TextColor" Value="{StaticResource OnSurface}" />
		<Setter Property="PlaceholderColor" Value="{StaticResource Outline}" />
		<Setter Property="BackgroundColor" Value="Transparent" />
		<Setter Property="FontSize" Value="14" />
	</Style>

	<Style TargetType="CheckBox">
		<Setter Property="Color" Value="{StaticResource Primary}" />
	</Style>

	<Style TargetType="Switch">
		<Setter Property="OnColor" Value="{StaticResource PrimaryContainer}" />
	</Style>

	<!-- ===== Labels ===== -->
	<Style x:Key="LabelHeadline" TargetType="Label">
		<Setter Property="TextColor" Value="{StaticResource OnSurface}" />
		<Setter Property="FontSize" Value="24" />
		<Setter Property="FontAttributes" Value="Bold" />
	</Style>
	<Style x:Key="LabelTitle" TargetType="Label">
		<Setter Property="TextColor" Value="{StaticResource OnSurface}" />
		<Setter Property="FontSize" Value="16" />
		<Setter Property="FontAttributes" Value="Bold" />
	</Style>
	<Style x:Key="LabelBody" TargetType="Label">
		<Setter Property="TextColor" Value="{StaticResource OnSurfaceVariant}" />
		<Setter Property="FontSize" Value="14" />
	</Style>
	<Style x:Key="LabelCaption" TargetType="Label">
		<Setter Property="TextColor" Value="{StaticResource Outline}" />
		<Setter Property="FontSize" Value="12" />
	</Style>
	<Style x:Key="LabelSection" TargetType="Label">
		<Setter Property="TextColor" Value="{StaticResource OnSurface}" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="TextTransform" Value="Uppercase" />
	</Style>
	<Style x:Key="LabelLink" TargetType="Label">
		<Setter Property="TextColor" Value="{StaticResource Primary}" />
		<Setter Property="FontSize" Value="14" />
		<Setter Property="FontAttributes" Value="Bold" />
	</Style>
	<Style x:Key="LabelError" TargetType="Label">
		<Setter Property="TextColor" Value="{StaticResource Error}" />
		<Setter Property="FontSize" Value="12" />
	</Style>

	<!-- ===== Conteneurs ===== -->
	<Style x:Key="Card" TargetType="Border">
		<Setter Property="BackgroundColor" Value="{StaticResource SurfaceContainer}" />
		<Setter Property="StrokeThickness" Value="0" />
		<Setter Property="StrokeShape" Value="RoundRectangle 12" />
		<Setter Property="Padding" Value="16" />
	</Style>
	<Style x:Key="InputBox" TargetType="Border">
		<Setter Property="BackgroundColor" Value="{StaticResource SurfaceContainer}" />
		<Setter Property="StrokeThickness" Value="0" />
		<Setter Property="StrokeShape" Value="RoundRectangle 8" />
		<Setter Property="Padding" Value="12,0" />
		<Setter Property="HeightRequest" Value="48" />
	</Style>
	<Style x:Key="Chip" TargetType="Border">
		<Setter Property="BackgroundColor" Value="{StaticResource SurfaceContainer}" />
		<Setter Property="StrokeThickness" Value="0" />
		<Setter Property="StrokeShape" Value="RoundRectangle 8" />
		<Setter Property="Padding" Value="12,6" />
	</Style>
	<Style x:Key="IconButton" TargetType="Border">
		<Setter Property="BackgroundColor" Value="{StaticResource SurfaceContainer}" />
		<Setter Property="StrokeThickness" Value="0" />
		<Setter Property="StrokeShape" Value="RoundRectangle 20" />
		<Setter Property="WidthRequest" Value="40" />
		<Setter Property="HeightRequest" Value="40" />
	</Style>

	<!-- ===== Boutons ===== -->
	<Style x:Key="PrimaryButton" TargetType="Button">
		<Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
		<Setter Property="TextColor" Value="{StaticResource OnPrimary}" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="FontSize" Value="14" />
		<Setter Property="CornerRadius" Value="12" />
		<Setter Property="HeightRequest" Value="48" />
		<Setter Property="Padding" Value="16,0" />
	</Style>
	<Style x:Key="SecondaryButton" TargetType="Button">
		<Setter Property="BackgroundColor" Value="{StaticResource SurfaceContainerHigh}" />
		<Setter Property="TextColor" Value="{StaticResource OnSurface}" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="FontSize" Value="14" />
		<Setter Property="CornerRadius" Value="12" />
		<Setter Property="HeightRequest" Value="48" />
		<Setter Property="Padding" Value="16,0" />
	</Style>
	<Style x:Key="SmallPrimaryButton" TargetType="Button">
		<Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
		<Setter Property="TextColor" Value="{StaticResource OnPrimary}" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="CornerRadius" Value="8" />
		<Setter Property="HeightRequest" Value="36" />
		<Setter Property="Padding" Value="12,0" />
	</Style>
	<Style x:Key="SmallSecondaryButton" TargetType="Button">
		<Setter Property="BackgroundColor" Value="{StaticResource SurfaceContainerHigh}" />
		<Setter Property="TextColor" Value="{StaticResource OnSurface}" />
		<Setter Property="FontAttributes" Value="Bold" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="CornerRadius" Value="8" />
		<Setter Property="HeightRequest" Value="36" />
		<Setter Property="Padding" Value="12,0" />
	</Style>

</ResourceDictionary>
